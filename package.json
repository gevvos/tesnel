{
  "name": "tesnel",
  "version": "0.0.0",
  "description": "Project structure visualizer",
  "main": "./dist/tesnel.js",
  "bin": {
    "tesnel": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx lib/cli/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "pnpm build:ui && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Gevvos",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "^1.62.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vue/compiler-sfc": "^3.5.33",
    "cac": "^7.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.11.1",
    "oxc-parser": "^0.128.0",
    "oxc-resolver": "^11.19.1",
    "vue": "^3.5.33",
    "zod": "^4.4.2"
  }
}
